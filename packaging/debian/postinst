#!/bin/sh
set -e

if ! getent group moblin2jpnkn >/dev/null; then
  addgroup --system moblin2jpnkn
fi

if ! getent passwd moblin2jpnkn >/dev/null; then
  adduser --system --ingroup moblin2jpnkn --no-create-home \
    --disabled-login --disabled-password moblin2jpnkn
fi

install -d -o root -g moblin2jpnkn -m 0755 /etc/moblin2jpnkn
# chown root:moblin2jpnkn /etc/moblin2jpnkn/config
# chmod 0640 /etc/moblin2jpnkn/config

#DEBHELPER#

exit 0